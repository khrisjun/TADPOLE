# ── Microsoft Bot Framework credentials ──────────────────────────────────────
# Leave empty for local testing with the Bot Framework Emulator.
MicrosoftAppId=
MicrosoftAppPassword=

# ── Web server ────────────────────────────────────────────────────────────────
PORT=3978

# ── Data source selection ─────────────────────────────────────────────────────
# Set to "snowflake", "oracle", or "csv".
# Leave empty to auto-detect (tries Snowflake → Oracle → CSV).
DATA_SOURCE=

# ── Snowflake ─────────────────────────────────────────────────────────────────
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_TABLE=TAID_RS_MAPPING
SNOWFLAKE_TAID_COLUMN=TAID
SNOWFLAKE_RS_COLUMN=RS_CODE

# ── Oracle (over TLS 1.2) ─────────────────────────────────────────────────────
# DSN format:  host:port/service_name  (e.g. db.example.com:1521/ORCL)
ORACLE_DSN=
ORACLE_USER=
ORACLE_PASSWORD=
# Path to an Oracle Wallet directory (or PEM certificate bundle directory)
# that contains the TLS 1.2 certificate authority chain.
ORACLE_WALLET_DIR=
ORACLE_TABLE=TAID_RS_MAPPING
ORACLE_TAID_COLUMN=TAID
ORACLE_RS_COLUMN=RS_CODE

# ── CSV / SQLite fallback ─────────────────────────────────────────────────────
# Absolute or relative path to the mapping CSV.
# Defaults to data/sample_taid_rs_codes.csv.
CSV_PATH=data/sample_taid_rs_codes.csv
CSV_TAID_COLUMN=TAID
CSV_RS_COLUMN=RS_CODE
