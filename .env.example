# ── Microsoft Bot Framework credentials ──────────────────────────────────────
# Leave empty for local testing with the Bot Framework Emulator.
MicrosoftAppId=
MicrosoftAppPassword=

# ── Web server ────────────────────────────────────────────────────────────────
PORT=3978

# ── Data source selection ─────────────────────────────────────────────────────
# Set to "snowflake", "oracle", or "csv".
# Leave empty to auto-detect (tries Snowflake → Oracle → CSV).
DATA_SOURCE=

# ── Snowflake ─────────────────────────────────────────────────────────────────
# Set SNOWFLAKE_USER to your RS Group email address (e.g. firstname.surname@rsgroup.com).
SNOWFLAKE_ACCOUNT=tf78969.eu-west-1
SNOWFLAKE_USER=
SNOWFLAKE_DATABASE=ORGDATACLOUD$INTERNAL$BLUE_YONDER
SNOWFLAKE_SCHEMA=BLUE_YONDER
SNOWFLAKE_WAREHOUSE=LAB_10_COMPUTE_DEFAULT_VWH
SNOWFLAKE_ROLE=LAB10_FULL_ROLE

# Authenticator: "externalbrowser" (default) opens a browser for SSO on first
# use and caches the token.  Switch to "snowflake" for username/password auth
# (requires SNOWFLAKE_PASSWORD to be set).
SNOWFLAKE_AUTHENTICATOR=externalbrowser
SNOWFLAKE_CLIENT_STORE_TEMP_CREDENTIAL=true

# Only required when SNOWFLAKE_AUTHENTICATOR=snowflake
SNOWFLAKE_PASSWORD=

SNOWFLAKE_TABLE=BY_DMDUNIT
SNOWFLAKE_TAID_COLUMN=DMDUNIT
SNOWFLAKE_RS_COLUMN=U_RS_PRODUCT_CODE

# ── Oracle (over TLS 1.2) ─────────────────────────────────────────────────────
# DSN format:  host:port/service_name  (e.g. db.example.com:1521/ORCL)
ORACLE_DSN=
ORACLE_USER=
ORACLE_PASSWORD=
# Path to an Oracle Wallet directory (or PEM certificate bundle directory)
# that contains the TLS 1.2 certificate authority chain.
ORACLE_WALLET_DIR=
ORACLE_TABLE=TAID_RS_MAPPING
ORACLE_TAID_COLUMN=TAID
ORACLE_RS_COLUMN=RS_CODE

# ── CSV / SQLite fallback ─────────────────────────────────────────────────────
# Absolute or relative path to the mapping CSV.
# Defaults to data/sample_taid_rs_codes.csv.
CSV_PATH=data/sample_taid_rs_codes.csv
CSV_TAID_COLUMN=DMDUNIT
CSV_RS_COLUMN=U_RS_PRODUCT_CODE
